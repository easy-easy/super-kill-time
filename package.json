{
  "name": "super-kill-time",
  "displayName": "Super Kill Time",
  "description": "Play quick time killers in VS Code.",
  "version": "0.0.1",
  "publisher": "easy-easy",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "super-kill-time.startBrickBreaker",
        "title": "%command.startBrickBreaker.title%"
      },
      {
        "command": "super-kill-time.startInvaders",
        "title": "%command.startInvaders.title%"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "vsce:package": "vsce package",
    "vsce:publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/easy-easy/super-kill-time.git"
  }
}
